{
  "name": "@soxhub/ember-formatjs",
  "version": "1.3.1",
  "description": "The default blueprint for ember-cli addons.",
  "keywords": [
    "ember-addon"
  ],
  "repository": "https://github.com/soxhub/ember-formatjs",
  "license": "MIT",
  "author": "",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel \"lint:!(fix)\"",
    "lint:fix": "npm-run-all --aggregate-output --continue-on-error --parallel lint:*:fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "ember-compatibility-tests": "ember try:each",
    "test": "npm-run-all lint test:*",
    "test:ember": "TRANSPILE_I18N=true ember test",
    "test:node": "mocha node-tests"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/soxhub"
  },
  "dependencies": {
    "@babel/helper-plugin-utils": "^7.14.5",
    "@formatjs/ts-transformer": "^3.6.0",
    "broccoli-persistent-filter": "^3.1.2",
    "broccoli-stew": "3.0.0",
    "calculate-cache-key-for-tree": "^2.0.0",
    "ember-cli-babel": "^7.26.6",
    "ember-cli-babel-plugin-helpers": "^1.1.1",
    "ember-cli-htmlbars": "^5.7.1",
    "ember-cli-version-checker": "^5.1.2"
  },
  "devDependencies": {
    "@ember/optional-features": "^2.0.0",
    "@ember/test-helpers": "^2.4.2",
    "@embroider/test-setup": "^0.43.5",
    "@glimmer/component": "^1.0.4",
    "@glimmer/tracking": "^1.0.4",
    "babel-eslint": "^10.1.0",
    "babel-plugin-tester": "^10.1.0",
    "broccoli-asset-rev": "^3.0.0",
    "broccoli-test-helper": "^2.0.0",
    "chai": "^4.3.4",
    "ember-auto-import": "^2.2.4",
    "ember-cli": "~3.28.4",
    "ember-cli-dependency-checker": "^3.2.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-disable-prototype-extensions": "^1.1.3",
    "ember-export-application-global": "^2.0.1",
    "ember-load-initializers": "^2.1.2",
    "ember-maybe-import-regenerator": "^0.1.6",
    "ember-page-title": "^6.2.2",
    "ember-qunit": "^5.1.4",
    "ember-resolver": "^8.0.2",
    "ember-source": "~3.28.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^3.6.0",
    "ember-try": "^1.4.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-ember": "^10.5.4",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-qunit": "^6.2.0",
    "loader.js": "^4.7.0",
    "mocha": "^9.1.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.2",
    "qunit": "^2.16.0",
    "qunit-dom": "^1.6.0",
    "webpack": "5"
  },
  "engines": {
    "node": "14.* || >= 16"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config",
    "before": [
      "ember-cli-htmlbars",
      "ember-cli-htmlbars-inline-precompile"
    ]
  },
  "resolutions": {
    "@babel/traverse": ">=7.23.2 <8.0.0",
    "@xmldom/xmldom": ">=0.7.7 <0.8.0",
    "cipher-base": ">=1.0.5 <2.0.0",
    "elliptic": ">=6.5.7 <7.0.0",
    "form-data": ">=3.0.4 <4.0.0",
    "handlebars": ">=4.7.9 <5.0.0",
    "pbkdf2": ">=3.1.3 <4.0.0",
    "sha.js": ">=2.4.12 <3.0.0",
    "shell-quote": ">=1.8.4 <2.0.0",
    "socket.io-parser": ">=4.0.5 <5.0.0",
    "websocket-driver": ">=0.7.5 <0.8.0"
  }
}
